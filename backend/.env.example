# Copy to backend/.env and adjust. All values are optional; defaults are shown.

# Where uploads and generated certificates are stored temporarily (relative to backend/).
STORAGE_DIR=storage

# Delete a session's uploads and outputs after this many minutes without activity.
RETENTION_MINUTES=60
# How often the cleanup thread checks for expired sessions.
CLEANUP_INTERVAL_SECONDS=300

# Upload limits.
MAX_EXCEL_MB=10
MAX_TEMPLATE_MB=30
MAX_FONT_MB=10
MAX_ROWS=5000
MAX_TEMPLATE_PIXELS=80000000

# Parallel rendering threads used during bulk generation.
MAX_WORKERS=4

# ---- Optional e-mail delivery --------------------------------------------------------
# Leave these empty to enter the e-mail account in the app instead (kept in memory only).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURITY=ssl, and an App Password.
SMTP_HOST=
SMTP_PORT=465
# ssl | starttls | none
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Pause between messages, and the maximum e-mails per send (Gmail personal ≈ 500/day).
EMAIL_DELAY_SECONDS=1.0
EMAIL_MAX_PER_BATCH=500

# Browser origins allowed to call the API directly (the Vite dev proxy does not need this).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
